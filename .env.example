# Peaker — örnek ortam (değerleri kendi Supabase projenizle doldurun).
# Kopyalayın: cp .env.example .env.local

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Yalnızca sunucu: server actions, admin client, migrasyon onarımları — asla istemciye koymayın.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- İsteğe bağlı: Sentry (yoksa uygulama normal çalışır) ---
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_ENABLED=1
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Yerel geliştirmede Sentry'e göndermek için: NEXT_PUBLIC_SENTRY_DEV=1
# Kaynak haritası (CI): SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT

# --- Faz 12 async worker (opsiyonel; queue feature flag aktifse zorunlu) ---
# pgmq adapter aktive et:
# PEAKER_QUEUE_ADAPTER=pgmq
# Worker HTTP endpoint için paylaşılan secret. Vercel Cron ve pg_cron+pg_net
# her dakika /api/jobs/process'i bu token ile çağırır. Production'da güçlü
# bir random string üretin (örn. openssl rand -hex 32).
# WORKER_SHARED_SECRET=
# Vercel Cron, Authorization: Bearer ${WORKER_SHARED_SECRET} ile çağırır.
# pg_net üzerinden Supabase Vault kullanılıyorsa:
#   vault.peaker_worker_url   = https://your-app.vercel.app/api/jobs/process
#   vault.peaker_worker_token = aynı WORKER_SHARED_SECRET değeri

# --- Faz 12 distributed rate limiter (opsiyonel) ---
# Backend seçimi: memory (default), upstash veya postgres.
# PEAKER_RATE_LIMIT_BACKEND=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Faz 12 performans MV read-path (opsiyonel) ---
# 1 = listPerformanceAnalyticsData takım modu MV'den okur (stale tolerance 6h).
# PEAKER_PERF_MV_READ=0
# Eşikler (opsiyonel override):
# PEAKER_PERF_MV_MIN_PROFILES=20
# PEAKER_PERF_MV_MIN_DAYS=14
